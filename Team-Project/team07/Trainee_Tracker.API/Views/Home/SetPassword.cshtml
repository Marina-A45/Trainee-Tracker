@*
Patrick Plechinger
*@
@model Trainee_Tracker.Core.Entity.SetPassword
@{
    ViewData["Title"] = "Set Password";
}

<link rel="stylesheet" href="~/css/SetPassword.css" />


<h1 class="page-title">CREATE USER</h1>

<!-- DASHBOARD CONTAINER -->
<div class="dashboard">

    <!-- Left: Progress -->
    <div class="progress-section">

        <div class="kpi-container">
            <form asp-action="SetPasswordData" class="login-form" method="post" data-testid="create-form">


                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input asp-for="guid" type="hidden" />
                <div class="form-group">
                    <label class="form-label -required" for="password">Password</label>

                    <div class="input-group">
                        <input class="form-control" autocomplete="off" type="password" placeholder="Password"
                               data-testid="create-password-input" id="password" asp-for="password" />

                        <button class="btn btn-outline-secondary" type="button"
                                onclick="togglePassword('password', this)">
                            Show
                        </button>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label -required" for="passwordRepeat">Repeat your Password</label>

                    <div class="input-group">
                        <input class="form-control" autocomplete="off" type="password" placeholder="Password"
                               data-testid="create-password-repeat-input" id="passwordRepeat" asp-for="passwordRepeat" />

                        <button class="btn btn-outline-secondary" type="button"
                                onclick="togglePassword('passwordRepeat', this)">
                            Show
                        </button>
                    </div>
                </div>

                <button type="submit" data-testid="submit-login" class="btn-gradient">
                    Set Password
                </button>

            </form>


        </div>

    </div>


</div>

<script>
    function togglePassword(inputId, button) {
        const input = document.getElementById(inputId);

        if (input.type === "password") {
            input.type = "text";
            button.textContent = "Hide";
        } else {
            input.type = "password";
            button.textContent = "Show";
        }
    }
</script>